(version 1)
(allow default)
(deny network*)
(deny file-read-data)
(allow file-read-data
    (literal "/")
    (subpath "/System")
    (subpath "/Library")
    (subpath "/usr")
    (subpath "/bin")
    (subpath "/sbin")
    (subpath "/private/preboot")
    (subpath "/private/var/db/timezone")
    (literal "/private/etc/localtime")
    (literal "/dev/null")
    (literal "/dev/urandom")
    (literal "/dev/random")
    (subpath (param "SDK_ROOT"))
    (subpath (param "TOOL_ROOT"))
    (literal (param "INPUT_DB"))
    (literal (param "INPUT_WAL"))
    (subpath (param "WORK_DIR")))
(deny file-write*)
(allow file-write*
    (literal "/dev/null")
    (subpath (param "WORK_DIR")))
